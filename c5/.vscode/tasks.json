{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C5: Build",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/tools/idf.ps1",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "C5: Host protocol tests",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/tools/test-host.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "C5: Bench tool self-tests",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/tools/bench.ps1",
        "-SelfTest"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "C5: Mainboard simulator",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/tools/bench.ps1",
        "-Port",
        "${input:simulatorPort}"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "C5: Flash and monitor",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/tools/idf.ps1",
        "-p",
        "${input:espPort}",
        "flash",
        "monitor"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ],
  "inputs": [
    {
      "id": "espPort",
      "type": "promptString",
      "description": "ESP32-C5 USB serial port, for example COM5"
    },
    {
      "id": "simulatorPort",
      "type": "promptString",
      "description": "Mainboard simulator USB-to-3.3V-TTL adapter COM port (NOT ESP USB console)"
    }
  ]
}
